{
	"version": 10,
	"configurePresets": [
		{
			"name": "single_cfg_gen_arhitecture",
			"hidden": true,
			"architecture": {
				"value": "x64",
				"strategy": "external"
			}
		},
		{
			"name": "multi_cfg_gen_arhitecture",
			"hidden": true,
			"architecture": {
				"value": "x64",
				"strategy": "set"
			}
		},
		{
			"name": "vcpkg_base",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": {
					"type": "FILEPATH",
					"value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
				}
			}
		},
		{
			"name": "vcpkg_triplet_windows",
			"hidden": true,
			"cacheVariables": {
				"VCPKG_TARGET_TRIPLET": "x64-windows"
			}
		},
		{
			"name": "vcpkg_triplet_linux",
			"hidden": true,
			"cacheVariables": {
				"VCPKG_TARGET_TRIPLET": "x64-linux"
			}
		},
		{
			"name": "build_mode_debug_cache_variable",
			"hidden": true,
			"cacheVariables": {
				"GW_CLIENT_CLI_BUILD_MODE": "Debug"
			}
		},
		{
			"name": "build_mode_release_cache_variable",
			"hidden": true,
			"cacheVariables": {
				"GW_CLIENT_CLI_BUILD_MODE": "Release"
			}
		},
		{
			"name": "build_mode_debug",
			"hidden": true,
			"inherits": "build_mode_debug_cache_variable",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "build_mode_release",
			"hidden": true,
			"inherits": "build_mode_release_cache_variable",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "generator_visual_studio_2026",
			"hidden": true,
			"generator": "Visual Studio 18 2026"
		},
		{
			"name": "generator_ninja",
			"hidden": true,
			"generator": "Ninja"
		},
		{
			"name": "compiler_clangCL",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_CXX_COMPILER": "clang-cl.exe"
			}
		},
		{
			"name": "compiler_clang",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_CXX_COMPILER": "clang++"
			}
		},
		{
			"name": "compiler_gcc",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_CXX_COMPILER": "g++"
			}
		},
		{
			"name": "code_is_covered",
			"hidden": true,
			"cacheVariables": {
				"GW_CLIENT_CLI_COVERING_CODE_THIS_BUILD": "ON",
				"GW_CLIENT_CLI_COMPILER_COVERAGE_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
				"GW_CLIENT_CLI_LINKER_COVERAGE_FLAGS": "-fprofile-instr-generate"
			}
		},
		{
			"name": "windows_vs2026_msvc_debug",
			"displayName": "win_vs2026_msvc_dbg",
			"inherits": [
				"multi_cfg_gen_arhitecture",
				"vcpkg_base",
				"vcpkg_triplet_windows",
				"generator_visual_studio_2026",
				"build_mode_debug_cache_variable"
			],
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"binaryDir": "${sourceDir}/build/vs2026_dbg",
			"cacheVariables": {
				"CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/output/vs2026_dbg",
				"CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/output/vs2026_dbg",
				"CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/output/vs2026_dbg"
			}
		},
		{
			"name": "windows_vs2026_msvc_release",
			"displayName": "win_vs2026_msvc_rel",
			"inherits": [
